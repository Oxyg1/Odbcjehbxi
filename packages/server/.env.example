# ---------------------------------------------------------------------------
# Backend (packages/server)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://tgdonate:tgdonate@localhost:5432/tgdonate
REDIS_URL=redis://localhost:6379

# From @BotFather. Also the HMAC seed for initData verification.
TELEGRAM_BOT_TOKEN=123456789:AA...replace-me
# Any long random string. Used as the webhook path segment AND the
# X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=change-me-to-32-random-characters
BOT_USERNAME=tgdonate_bot

PUBLIC_API_URL=https://api.tgdonate.app
PUBLIC_WEBAPP_URL=https://tgdonate.app
CORS_ORIGINS=https://tgdonate.app,https://web.telegram.org

# 'polling' locally, 'webhook' in production.
BOT_MODE=polling
ENABLE_BOT=true

# Reject a Mini App launch payload older than this.
INITDATA_MAX_AGE_SECONDS=86400

# Platform fee in basis points. 500 = 5%.
PLATFORM_FEE_BPS=500

# --- TON (optional; leave the watcher off until an escrow wallet exists) ---
TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
TON_ESCROW_ADDRESS=
TON_POLL_INTERVAL_MS=8000
ENABLE_TON_WATCHER=false

# ---------------------------------------------------------------------------
# Frontend (packages/web) — Vite only exposes VITE_-prefixed variables
# ---------------------------------------------------------------------------
# Leave BOTH of these EMPTY for the normal deployment, where nginx serves the
# Mini App and proxies /api and /ws to the backend on the same host. The client
# then talks to its own origin, which needs no configuration and can never be
# blocked as mixed content.
#
# They are baked into the bundle at BUILD time, so a localhost value ships a
# build that asks the viewer's own phone for the API. Only set them when the API
# genuinely lives on another host, and then use its public https/wss URL.
VITE_API_URL=
VITE_WS_URL=
VITE_BOT_USERNAME=tgdonate_bot
VITE_TONCONNECT_MANIFEST=https://tgdonate.app/tonconnect-manifest.json
# Optional: a signed initData fixture so the app runs in a plain browser tab.
VITE_DEV_INIT_DATA=
