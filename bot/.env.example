# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте и не выкладывайте.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Ваш числовой Telegram ID (узнать: написать боту @userinfobot). Бот отвечает ТОЛЬКО этому пользователю.
OWNER_ID=123456789

# Приватный seed кошелька (64 hex-символа) из строки "private seed:" в found.txt
WALLET_SEED=

# Версия кошелька: v5 или v4 (какую искали в ton-vanity; по умолчанию v5)
WALLET_VERSION=v5

# Адрес кошелька (любая форма, EQ... или UQ...). Бот не запустится, если seed даёт другой адрес.
WALLET_ADDRESS=

# Необязательно:
# TONCENTER_API_KEY=            # ключ с https://t.me/tonapibot - убирает лимит 1 запрос/сек
# NETWORK=mainnet               # mainnet (по умолчанию) или testnet
# MAX_SEND_TON=100              # максимум за один перевод (защитный лимит)
