# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Где хранить базу с кэшем сообщений и скачанные медиа
DB_PATH=data/tracker.db
MEDIA_DIR=data/media

# Часовой пояс для дат в уведомлениях (IANA, например Europe/Moscow)
TIMEZONE=Europe/Moscow

# Сколько дней хранить кэш сообщений (0 = хранить вечно)
RETENTION_DAYS=30

# Пауза в секундах, за которую удаления склеиваются в одно уведомление
DELETE_DEBOUNCE=2.0

# Сколько удалённых за раз сообщений считать признаком удаления всей переписки
CHAT_DELETE_THRESHOLD=5

# Ограничения на объём уведомлений
PREVIEW_LIMIT=700        # символов текста на одно сообщение в отчёте
MAX_MESSAGES_IN_REPORT=25
MAX_MEDIA_ITEMS=10       # сколько удалённых медиа переслать себе

# Медиа
BACKUP_MEDIA=true        # скачивать медиа сразу при получении (надёжнее)
MAX_MEDIA_MB=20          # не скачивать файлы больше этого размера

# Поведение уведомлений по умолчанию (меняется командой /settings)
NOTIFY_EDITS=true
NOTIFY_DELETES=true
INCLUDE_OWN=false        # уведомлять и о ваших собственных сообщениях
SILENT_NOTIFICATIONS=false

LOG_LEVEL=INFO
