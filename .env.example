# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# --- Puzzle ---
# 3 digits, 0-9. This is the combination that opens the vault.
SECRET_CODE=732
DIAL_COUNT=3

# --- State backend ---
# memory | redis
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Seconds a vault's dial state is kept alive (Redis backend only).
STATE_TTL=86400

# --- Reward provider ---
# static | llm
REWARD_PROVIDER=static
STATIC_REWARD=You cracked it. Promo code: CRYPTEX-732-OPEN
# Only used when REWARD_PROVIDER=llm
ANTHROPIC_API_KEY=
REWARD_MODEL=claude-sonnet-5
