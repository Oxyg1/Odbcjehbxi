# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# --- Google AI Studio (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
# Without it the bot still runs: codes are generated locally and the reveal
# falls back to STATIC_REWARD.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Puzzle ---
DIAL_COUNT=3
# Normally left empty: every vault's combination is generated per game.
# Set it only to pin a code for debugging or a demo.
SECRET_CODE=

# --- State backend ---
# memory | redis
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Seconds a vault's state is kept alive (Redis backend only).
STATE_TTL=86400

# --- Reward fallback, used when Gemini is unavailable ---
# Supports {user_name}, {code}, {attempts}, {theme}.
STATIC_REWARD=The door gives, and {theme} exhales dust into the light. Whatever was worth guarding is still here, and it is yours.
