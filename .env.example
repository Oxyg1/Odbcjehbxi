# ══════════════════════════════════════════════════════════════════════════════
#  Frog Tamagotchi — настройки
# ══════════════════════════════════════════════════════════════════════════════
#
#  Скопируй в .env рядом с bot.py и заполни:
#      cp .env.example .env
#
#  .env в git не попадает (см. .gitignore). Переменные окружения сильнее
#  файла, поэтому в докере и systemd можно переопределять, не трогая .env.
#

# ── Обязательное ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Без него бот не запустится.
BOT_TOKEN=

# ── Чаты и права ─────────────────────────────────────────────────────────────
# Основной чат бота. Узнать: добавь бота в чат и напиши /chatid
CHAT_ID=

# Чат администраторов — туда уходят уведомления о событиях и ошибках.
# Можно оставить пустым: тогда уведомления придут в ЛС каждому из ADMIN_IDS.
ADMIN_CHAT_ID=

# Telegram-id администраторов через запятую. Узнать свой: @userinfobot
ADMIN_IDS=

# Закрытый чат владельцев NFT. Пусто = проверка членства отключена.
NFT_CLUB_CHAT_ID=

# ── Внешние сервисы ──────────────────────────────────────────────────────────
# Строка аутентификации Telegram WebApp для see.tg — ЖИВОЙ СЕКРЕТ с личными
# данными. Получить: открыть https://poso.see.tg в Telegram WebApp и скопировать
# параметр tgauth из запросов. Пусто = интеграция с see.tg отключена.
SEETG_TGAUTH=

# ── Хранилище и логи ─────────────────────────────────────────────────────────
DB_PATH=frog_game.db
LOG_FILE=bot.log
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Путь к самому файлу настроек (нужен редко, для нескольких окружений)
# ENV_FILE=.env.staging

# ── Рассылки ─────────────────────────────────────────────────────────────────
# Сколько сообщений в секунду отправлять при массовой рассылке
BULK_SEND_LIMIT=30

# Порог неактивности для рассылки о комаре, часов
MOSQUITO_ACTIVE_HOURS=720


# ══════════════════════════════════════════════════════════════════════════════
#  Любая константа бота — через префикс FROG_
# ══════════════════════════════════════════════════════════════════════════════
#
#  Перечислять все 245 констант здесь не нужно: подойдёт любое имя из bot.py,
#  написанное КАПСОМ. Тип берётся у текущего значения, поэтому число останется
#  числом, а true/false — булевым. Списки задаются через запятую.
#
#  Что переопределено — бот печатает при запуске.
#
#  Примеры (закомментированы — это значения по умолчанию):

# ── Экономика ──
# FROG_NFT_KVA_COINS=1000          # цена повторного «ква» в монетах
# FROG_NFT_KVA_STARS=2             # цена повторного «ква» в Stars
# FROG_NFT_KVA_TOTAL=1000          # каждые N «ква» — один выигрыш
# FROG_NFT_KVA_ENABLED=true        # включён ли дроп Chill Flame

# ── Стаи и война ──
# FROG_SKIRMISH_ENTRY_COINS=2000   # взнос за стычку из котла
# FROG_SKIRMISH_WIN_PCT=0.30       # доля котла проигравшего победителю
# FROG_SKIRMISH_WIN_MAX=5000       # потолок выигрыша
# FROG_SKIRMISH_GATHER_SEC=180     # время сбора отряда
# FROG_SKIRMISH_ROUND_SEC=90       # время на ход в дуэли
# FROG_RAID_MAX_STEAL_PCT=0.20     # сколько можно унести из чужого котла

# ── Экспедиции ──
# FROG_EXP_MAX_PLAYERS=6
# FROG_EXP_MIN_PLAYERS=2
# FROG_EXP_MAX_SUPPLY_TOTAL=10     # припасов с собой

# ── Фриз-ивент ──
# FROG_FZ_DROP_CHANCE=1000         # шанс дропа NFT — 1 к N
# FROG_FZ_TOTAL_NFT=10             # сколько NFT в пуле
# FROG_FZ_POOL_COINS_PER_THROW=5   # монет за бросок в sold-out пуле
