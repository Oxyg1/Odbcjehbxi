# Get a token from @BotFather on Telegram
BOT_TOKEN=

# Optional: proxy used for the bot's own connection to api.telegram.org
# (needed if Telegram is blocked/unreachable on your network).
# HTTP proxy example: http://user:pass@1.2.3.4:8080
# SOCKS5 proxy example: socks5://user:pass@1.2.3.4:1080
BOT_API_PROXY=

# Optional: comma-separated list of HTTP proxies, e.g. http://user:pass@1.2.3.4:8080,http://5.6.7.8:3128
PROXIES=

# Optional: path to SQLite database file
DATABASE_PATH=data/usernames.db

# Optional: log file path
LOG_FILE=data/bot.log

# Optional: max concurrent checks per domain per second
RATE_LIMIT_PER_SECOND=5

# Optional: cache TTL for availability checks, in seconds
CACHE_TTL_SECONDS=300
