# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# --- Google AI Studio (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
# Without it the bot still runs: codes and clues are generated locally and the
# reveal falls back to a canned line — in both languages.
GEMINI_API_KEY=
# Run `python -m cryptexbot.models` to list the models your key can reach.
GEMINI_MODEL=gemini-3.6-flash
# Round-trip each generated clue through a solver that has not seen the code,
# and replace any that do not resolve. One extra fast call per vault.
QUEST_VERIFY=true

# --- Language ---
# en | ru. Used before a player has chosen, and for anyone who never does.
DEFAULT_LANG=en
# false skips the picker and starts every vault in DEFAULT_LANG. Players can
# still switch with the 🌐 button or /lang.
ASK_LANGUAGE=true

# --- Puzzle ---
DIAL_COUNT=3
# Normally left empty: every vault's combination is generated per game.
# Set it only to pin a code for debugging or a demo.
SECRET_CODE=

# --- State backend ---
# memory | redis
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Seconds a vault's state is kept alive (Redis backend only).
STATE_TTL=86400

# --- Reward fallback ---
# Optional. Left empty, the offline prize comes from the translation table and
# follows the player's language. Supports {user_name}, {code}, {attempts}, {theme}.
STATIC_REWARD=
