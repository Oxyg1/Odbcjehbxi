# Скопируй в .env и заполни. Файл .env в git НЕ попадает (см. .gitignore).
#
# ВАЖНО: в коде у этих переменных не должно быть fallback-значений.
# Используй os.environ["BOT_TOKEN"], а не os.getenv("BOT_TOKEN", "<токен>") —
# иначе забытая переменная окружения приведёт к запуску с чужим/старым токеном.

# ── Telegram ──────────────────────────────────────────────
# Получить у @BotFather. Если старый токен попадал в исходники — /revoke.
BOT_TOKEN=

# Основной чат сообщества (число со знаком минус, узнать через /chatid)
CHAT_ID=

# Чат/ЛС для админских уведомлений
ADMIN_CHAT_ID=

# Telegram user id админов через запятую
ADMIN_IDS=

# Закрытый чат NFT-холдеров
NFT_CLUB_CHAT_ID=

# ── Внешние API ───────────────────────────────────────────
# initData Telegram WebApp для poso.see.tg (JSON-строка).
# Протухает — обновлять здесь, не в коде.
SEETG_TGAUTH=

# ── Настройки ─────────────────────────────────────────────
DB_PATH=frog_game.db
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Порог неактивности для рассылки комара, часов
MOSQUITO_ACTIVE_HOURS=720
