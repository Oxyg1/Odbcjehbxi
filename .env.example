# Скопируй в .env и заполни. Файл .env в git НЕ попадает (см. .gitignore).
#
# Переменные, помеченные ОБЯЗАТЕЛЬНО, не имеют значений по умолчанию:
# без них бот упадёт на старте с понятной ошибкой ConfigError.
# Это сделано намеренно — забытая переменная не должна приводить
# к запуску с чужим или устаревшим токеном.

# ── Telegram ──────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Получить у @BotFather.
# Если старый токен попадал в исходники — сначала /revoke.
BOT_TOKEN=

# ОБЯЗАТЕЛЬНО. Основной чат сообщества (отрицательное число, узнать через /chatid)
CHAT_ID=

# ОБЯЗАТЕЛЬНО. Чат или ЛС для админских уведомлений
ADMIN_CHAT_ID=

# ОБЯЗАТЕЛЬНО. Закрытый чат NFT-холдеров
NFT_CLUB_CHAT_ID=

# Telegram user id админов через запятую. Пусто = админов нет.
ADMIN_IDS=

# ── Секреты ───────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Пароль для /adminsecretgift.
SECRET_GIFT_ADMIN_PASS=

# initData Telegram WebApp для poso.see.tg (JSON-строка) — это учётные данные.
# Протухает: обновлять здесь, не в коде. Пусто = See.tg-функции не работают.
SEETG_TGAUTH=

# ── Настройки ─────────────────────────────────────────────
DB_PATH=frog_game.db
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Порог неактивности для рассылки комара, часов
MOSQUITO_ACTIVE_HOURS=720
