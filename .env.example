# Copy to .env — this file holds every secret the bot needs.
# .env and sessions/ are git-ignored; keep them that way.

# From https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=

# Optional: pre-fill the login prompt (`python -m tgmarket login`).
TG_PHONE=
# Two-factor password. Leave empty to be prompted interactively instead.
TG_PASSWORD=

# Alternative to a session file — a Telethon StringSession. Useful for
# containers with no persistent volume. Anyone holding it owns the account.
TG_SESSION_STRING=
TG_SESSION_NAME=tgmarket
TG_SESSION_DIR=sessions

# Optional transport. MTProto proxy needs no extra dependency:
#   TG_PROXY=mtproxy://proxy.example.com:443?secret=ee00...
#   TG_PROXY=socks5://user:pass@127.0.0.1:1080   (pip install 'telethon[socks]')
TG_PROXY=

# Status/purchase notifications through a normal bot (talk to @BotFather).
# Set both to switch notifications on.
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# Emergency brake: DRY_RUN=true wins over config.yaml and the --live flag is
# still required to spend anything.
DRY_RUN=true
LOG_LEVEL=INFO
STATE_PATH=data/state.json
